# TEMPLATE ONLY - this file is committed to git. Put real values in .env.local (not committed)
# and in Vercel -> Project -> Settings -> Environment Variables.

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key

# Platform WhatsApp number for "Message us" on the homepage (923001234567 format)
NEXT_PUBLIC_PLATFORM_WHATSAPP=923001234567

# New shop request email notifications (Resend). Optional - skipped when unset.
RESEND_API_KEY=
REQUEST_NOTIFY_EMAIL=you@example.com
RESEND_FROM=Dukaan <onboarding@resend.dev>

# Any long random string; hashes request IPs for rate limiting
REQUEST_IP_SALT=change-me

# Canonical site URL for sitemap/robots/canonical tags/OG links. Defaults to https://dukaan-online.vercel.app
# on Vercel; set this when you move to a custom domain (e.g. https://dukaan.pk).
NEXT_PUBLIC_SITE_URL=

# Google Search Console "HTML tag" verification code (just the content="..." value). Optional.
GOOGLE_SITE_VERIFICATION=

# Only if Supabase rejects the default phone-login domain (see lib/login.ts)
# NEXT_PUBLIC_PHONE_LOGIN_DOMAIN=
